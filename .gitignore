# Local scratch and OS files — never commit these.
node_modules/
.DS_Store
_site/
*.log

# NOTE: engine/ is intentionally NOT ignored. The tests must be in the repo
# so CI can run them. They are kept OUT of the *served* site by the deploy
# workflow (.github/workflows/deploy.yml excludes engine/ from _site), not by
# gitignore. Do not add "engine/" here.
